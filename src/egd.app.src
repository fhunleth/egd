{application, egd,
 [{description, "Erlang Graphical Drawer"},
  {vsn, "0.10.1"},
  {registered, []},
  {applications, [kernel,
                  stdlib]},
  {env,[]},
  {modules, [egd,
             egd_font,
             egd_png,
             egd_primitives,
             egd_render]},
  %% hex.pm properties
  {pkg_name, egd_fhunleth}, % reserve name 'egd' for the original author, however
                            % ownership can be transferred later too:
                            % https://hexdocs.pm/rebar3_hex/rebar3_hex_owner.html
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub","https://github.com/fhunleth/egd_fhunleth"}]}
 ]}.

